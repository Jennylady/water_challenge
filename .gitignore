#################################
# ENV FILES (backend + frontend)
#################################
**/.env
**/.env.*

#################################
# DJANGO BACKEND
#################################
backend/__pycache__/
backend/*.py[cod]
backend/*.sqlite3
backend/db.sqlite3
backend/media/
backend/staticfiles/
backend/*.log

# Django migrations (optionnel si tu veux éviter de push)
# backend/**/migrations/*
# !backend/**/migrations/__init__.py

#################################
# PYTHON
#################################
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
ENV/

#################################
# FRONTEND (React / Node)
#################################
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.next/

#################################
# LOGS
#################################
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#################################
# IDE
#################################
.vscode/
.idea/
*.iml

#################################
# OS FILES
#################################
.DS_Store
Thumbs.db

#################################
# TEST / CACHE
#################################
.pytest_cache/
.coverage
htmlcov/